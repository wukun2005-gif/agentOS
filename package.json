{
  "name": "ai-os-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "npm run verify:prompts && npm run verify:window",
    "verify:window": "esbuild scripts/verify-window-model.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify-window.mjs --log-level=warning && node node_modules/.tmp/verify-window.mjs",
    "verify:prompts": "esbuild scripts/verify-prompts.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify-prompts.mjs --log-level=warning && node node_modules/.tmp/verify-prompts.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5"
  }
}
